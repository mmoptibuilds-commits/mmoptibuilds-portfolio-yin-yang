# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for development. Never commit real values.
# Use separate Supabase projects and Turnstile keys per environment.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute origin, used for canonical URLs, the sitemap and social cards.
# MUST be the real origin in production, or canonicals point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────────────────
# Leave both blank and enquiries are written to .enquiries/ on disk instead,
# with real validation, deduplication, rate limiting and reference IDs. Set
# them and the app switches to Postgres with no code change.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row-level security — never expose this to the browser.
SUPABASE_SECRET_KEY=

# ── Cloudflare Turnstile ────────────────────────────────────────────────────
# Leave blank and submissions are accepted but recorded with
# `turnstile_ok = false`, so the console shows they were not checked. Set both
# to enforce the browser check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Abuse fingerprinting ────────────────────────────────────────────────────
# Salt for the one-way hash used to rate-limit submissions. Raw IP addresses
# are never stored. Set a long random value in production; changing it resets
# rate-limit windows, which is harmless.
ABUSE_FINGERPRINT_SALT=

# ── Owner console ───────────────────────────────────────────────────────────
# Development-only shortcut so /admin is usable before Supabase Auth exists.
# lib/owner-auth.ts refuses this path when NODE_ENV=production, so a
# deployment that forgets Supabase gets a locked door, not an open one.
ADMIN_DEV_PASSWORD=

# ── Owner notifications (optional) ──────────────────────────────────────────
# Not required for launch: enquiries are visible in /admin without email.
OWNER_NOTIFICATION_EMAIL=
CF_EMAIL_FROM=
RESEND_API_KEY=
